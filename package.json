{
  "name": "gitlab-docs-mcp",
  "version": "1.1.5",
  "mcpName": "io.github.ozanmutlu/gitlab-docs",
  "author": "Ozan Mutlu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozanmutlu/Gitlab-Docs-MCP.git"
  },
  "description": "GitLab documentation search for AI assistants via Model Context Protocol (MCP)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gitlab-docs-mcp": "dist/bin.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc --watch",
    "dev": "tsx src/index.ts",
    "build-index": "tsx scripts/build-index.ts",
    "prepare": "npm run build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage",
    "validate": "npm run typecheck && npm run lint && npm run test"
  },
  "keywords": [
    "gitlab",
    "mcp",
    "model-context-protocol",
    "ai-assistant",
    "documentation",
    "search",
    "claude",
    "copilot"
  ],
  "files": [
    "dist/",
    "data/gitlab-docs/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "flexsearch": "^0.8.212",
    "lru-cache": "^11.5.2",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
